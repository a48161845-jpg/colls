# Токен от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать: @userinfobot)
ADMIN_IDS=
# ОНЛАЙН-БАЗА (PostgreSQL): Supabase, Neon, Railway, Render или свой сервер.
# Пример: postgresql://user:password@host:5432/dbname?sslmode=require
# Если пусто, бот использует локальный файл SQLite (DB_PATH) — удобно для проб.
DATABASE_URL=
DB_PATH=
# Премиум-эмодзи в текстах (нужен Telegram Premium у ВЛАДЕЛЬЦА бота). 0 — выключить
PREMIUM_EMOJI=1
# Премиум-иконки на inline-кнопках (Bot API 9.4). Если Telegram их не примет, бот сам отключит
PREMIUM_BUTTONS=0
# Анимированные карточки (GIF с искрами и светом). 0 — обычные картинки, быстрее и легче
ANIMATED_IMAGES=1
LOG_LEVEL=INFO
# @username поддержки для /help
SUPPORT=
